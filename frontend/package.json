{
  "name": "course-ta-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src *.json *.ts index.html",
    "format:check": "prettier --check src *.json *.ts index.html"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
