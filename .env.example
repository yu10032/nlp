# 复制为 .env；相对路径以 work 为根。
TA_DATABASE_URL=sqlite:///data/runtime/assistant.db
TA_STORAGE_DIR=data/runtime/uploads
# 已允许在线生成。填写下列三项并把 provider 改为 external 后启用。
# base_url 应为兼容 chat/completions 与 JSON 输出的服务地址，包含 /v1 等前缀。
TA_GENERATION_PROVIDER=disabled
TA_LLM_BASE_URL=
TA_LLM_API_KEY=
TA_LLM_MODEL=
TA_MATCHER_CHECKPOINT=
